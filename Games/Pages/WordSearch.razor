@page "/wordsearch"

@implements IAsyncDisposable;

@using System.Collections.Generic;
@using Games.WordSearch
@using Games.Services
@using Microsoft.AspNetCore.Components.Web

@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject Microsoft.JSInterop.IJSRuntime JS

@code {
    [Inject]
    public IWordService WordService { get; set; } = null!;

    private string[] wordList = new string[] {};
    private Search theGameW = new Search();
    private const string localStorageLabel = "wordSearch";

    private ElementReference puzzleTable;
    private bool isDragging = false;
    private HashSet<(int, int)> draggedCells = new();

    protected override async Task OnInitializedAsync()
    {
        await Setup(false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await localStorage.SetItemAsync("lastPage", "wordSearch");

        if (firstRender)
        {
            await JS.InvokeVoidAsync("wordSearchDrag.init", puzzleTable);
        }
    }

    public async Task Setup(bool newGame = false)
    {
        wordList = await WordService.GetWords();

        var inLocalStorage = await localStorage.ContainKeyAsync(localStorageLabel);

        if (inLocalStorage && !newGame)
        {
            theGameW = await localStorage.GetItemAsync<Search>(localStorageLabel);
            theGameW.BuildIndex();
        }
        else
        {
            theGameW = new Search();

            theGameW.Setup(wordList.OrderBy(o => System.Guid.NewGuid().ToString()).Take(10).ToList(), 10, 10);

            await localStorage.SetItemAsync(localStorageLabel, theGameW);
        }
    }

    public void Solve()
    {
        theGameW.HidePuzzle = !theGameW.HidePuzzle;
        theGameW.HideSolution = !theGameW.HideSolution;
    }

    public void ToggleCell(int r, int c)
    {
        var cell = theGameW.BgColorIndex[(r, c)];
        cell.Value = cell.Value == "00f" ? "#fd7" : "00f";
    }

    private void OnCellPointerDown(int r, int c)
    {
        isDragging = true;
        draggedCells = new HashSet<(int, int)> { (r, c) };
        ToggleCell(r, c);
    }

    private void OnCellPointerEnter(int r, int c, PointerEventArgs e)
    {
        if (!isDragging) return;

        // Mouse released outside the table — cancel the drag.
        if (e.PointerType == "mouse" && e.Buttons == 0)
        {
            isDragging = false;
            draggedCells.Clear();
            return;
        }

        if (draggedCells.Add((r, c)))
        {
            ToggleCell(r, c);
        }
    }

    private async Task EndDrag()
    {
        if (!isDragging) return;
        isDragging = false;
        draggedCells.Clear();
        await localStorage.SetItemAsync(localStorageLabel, theGameW);
    }

    public async Task CrossOut(int index)
    {
        if (theGameW.Finds[index] == "")
        {
            theGameW.Finds[index] = "line-through";
        }
        else
        {
            theGameW.Finds[index] = "";
        }
        await localStorage.SetItemAsync(localStorageLabel, theGameW);
    }   

    public async ValueTask DisposeAsync()
    {
        await localStorage.SetItemAsync(localStorageLabel, theGameW);
    }
}

<div class="container">
    <div class="row">
        <div class="col">
            <table>
                <tr><th><u>Find:</u></th></tr>
                @if (theGameW != null)
                {
                    for (int find = 0; find < theGameW.Found.Count; find++)
                    {
                        string print = theGameW.Found[find];
                        var local_find = find;
                        <tr><td style="text-decoration: @theGameW.Finds[find];" @onclick="(async e => await CrossOut(local_find))">@print</td></tr>
                    }
                }
            </table> 
            <button type="button" class="btn btn-link" style="padding: 0px;%; margin-bottom: 10px;" @onclick="@Solve">Solution &rArr;</button> 
        </div>
        <div class="col-10" hidden="@theGameW.HidePuzzle">
            <table @ref="puzzleTable" class="puzzle-grid"
                   @onpointerup="EndDrag"
                   @onpointercancel="EndDrag"
                   @onpointerleave="EndDrag">
                @if (theGameW != null)
                {
                    for (int r = 0; r < theGameW.Height; r++)//print puzzle
                    {
                        var local_r = r;
                        <tr>
                            @for (int c = 0; c < theGameW.Width; c++)
                            {
                                var local_c = c;
                                <td style="width: 25px; text-align: center;background-color:@theGameW.BgColorIndex[(r, c)].Value"
                                    @onpointerdown="@(e => OnCellPointerDown(local_r, local_c))"
                                    @onpointerenter="@(e => OnCellPointerEnter(local_r, local_c, e))">@theGameW.PuzzleIndex[(r, c)].Value</td>
                            }
                        </tr>
                    }
                }
            </table>
        </div>
        <div class="col-10" hidden="@theGameW.HideSolution">
            <table>
                @if (theGameW != null)
                {
                    for (int r = 0; r < theGameW.Height; r++)//print solution
                    {
                        <tr>
                            @for (int c = 0; c < theGameW.Width; c++)
                            {
                                <td style="width: 25px; text-align: center;">@theGameW.SolutionIndex[(r, c)].Value</td>
                            }
                        </tr>
                    }
                }
            </table>
        </div>
    </div>
    <div class="row">
        <div class="col setup">
            <button style="margin-top: 10px;" @onclick="(e => Setup(true))">New</button>
        </div>
    </div>
</div>

<style>
    .puzzle-grid {
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
    }

    .puzzle-grid td {
        cursor: pointer;
    }

    .setup {
        color: black;
        float: right;
    }

    .setup button {
        background-color: transparent;
        text-align: center;
        vertical-align: middle;
        display: inline-flex;
        justify-content: center;
        border: 1px solid black;
        color: black;

        padding: .25rem .5rem;
        font-size: .875rem;
        line-height: 1.5;
        border-radius: .2rem;
    }
</style>